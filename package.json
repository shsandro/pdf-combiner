{
  "name": "pdf-combiner",
  "version": "0.1.0",
  "description": "Merge several PDFs (buffers, files, file paths or URLs) into a single PDF, in Node or the browser",
  "type": "module",
  "main": "./dist/node.js",
  "types": "./dist/node.d.ts",
  "browser": "./dist/browser.js",
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/browser.d.ts",
        "default": "./dist/browser.js"
      },
      "node": {
        "types": "./dist/node.d.ts",
        "default": "./dist/node.js"
      },
      "default": {
        "types": "./dist/browser.d.ts",
        "default": "./dist/browser.js"
      }
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "prepare": "npm run build"
  },
  "keywords": [
    "pdf",
    "merge",
    "combine",
    "pdf-lib"
  ],
  "license": "MIT",
  "dependencies": {
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "5.8.3"
  }
}
